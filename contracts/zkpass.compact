// zkPass Lite: Private Access Checker
// A minimal Midnight contract demonstrating privacy-preserving access control.
//
// ─── Architecture (Kachina Protocol) ─────────────────────────────────────────
// Midnight uses the Kachina protocol's dual-state model:
//   PUBLIC STATE  (ledger)  → on-chain, visible to all network participants
//   PRIVATE STATE (witness) → local only, never leaves the user's machine
//
// A zero-knowledge proof bridges the two: it proves a computation over private
// data was performed correctly, without revealing that data.
//
// ─── Privacy Model (Selective Disclosure) ────────────────────────────────────
// In this contract:
//   PRIVATE: The user's eligibility token (accessed via witness function)
//   PUBLIC:  The commitment hash, the access result, and the access count
//
// The user's raw token is never published. Only its hash (commitment) is
// disclosed for verification against the public eligible set. This is the
// standard commitment scheme pattern in zero-knowledge systems.
//
// ─── Storage Model ───────────────────────────────────────────────────────────
//   accessCount          Counter       : how many successful checks occurred
//   lastStatus           Bytes<14>: result of latest check
//   eligibleCommitments  Set<Bytes<32>>: hashed commitments of eligible tokens
//   adminCommitment      Bytes<32>     : commitment to the deployer's admin secret

pragma language_version >= 0.19;

import CompactStandardLibrary;

// ─── Public Ledger State (on-chain, visible to all) ────────────────────────────

// Tracks total successful access verifications
export ledger accessCount: Counter;

// Human-readable status of the most recent check
export ledger lastStatus: Bytes<14>;

// Set of hashed commitments for eligible tokens.
// Each entry is hash(raw_token). The raw tokens are never stored on-chain.
export ledger eligibleCommitments: Set<Bytes<32>>;
export ledger adminCommitment: Bytes<32>;

// ─── Witness Function (private, local only) ────────────────────────────────────
// Witnesses provide private data from the user's local environment.
// They execute on the user's machine during proof generation.
// Their return values NEVER leave the user's device or appear on-chain.
witness local_eligibility_token(): Bytes<32>;
witness local_admin_secret(): Bytes<32>;

// ─── Constructor ───────────────────────────────────────────────────────────────
// Called once at deployment. Initializes public ledger state.
constructor(adminCommitment_: Bytes<32>) {
  // Counter and Set start at their defaults (0 and empty).
  adminCommitment = disclose(adminCommitment_);
}

// ─── Circuit: addEligible ──────────────────────────────────────────────────────
// Admin function: adds a hashed commitment to the eligible set.
//
// Parameters:
//   commitment (Bytes<32>): the hash of an eligibility token.
//     The admin computes hash(raw_token) off-chain and submits the hash.
//     This means the raw token is never on-chain, even during setup.
//
// Public effect: inserts the commitment into eligibleCommitments set.
export circuit addEligible(commitment: Bytes<32>): [] {
  assert(persistentHash<Bytes<32>>(local_admin_secret()) == adminCommitment, "Only admin can add eligible tokens");
  eligibleCommitments.insert(disclose(commitment));
}

// ─── Circuit: checkAccess ──────────────────────────────────────────────────────
// User function: proves eligibility using a private token.
//
// How it works:
//   1. The witness function retrieves the user's private token locally
//   2. The circuit hashes the token to produce a commitment
//   3. The commitment is disclosed (made public) for set membership check
//   4. assert() verifies the commitment exists in the eligible set
//   5. If valid: status updated and counter incremented (on-chain)
//   6. If invalid: proof generation fails, no transaction is submitted
//
// What stays PRIVATE: the raw eligibility token (via witness)
// What becomes PUBLIC: the commitment hash, "access-granted" status, count
export circuit checkAccess(): [] {
  // Step 1: Get private token from local witness (never leaves user's device)
  const token = local_eligibility_token();

  // Step 2: Compute commitment hash (private computation inside the circuit)
  const commitment = persistentHash<Bytes<32>>(token);

  // Step 3-4: Disclose commitment and verify against eligible set
  // disclose() marks the value as safe for public ledger comparison.
  // The raw token remains private: only its hash is disclosed.
  assert(eligibleCommitments.member(disclose(commitment)), "Not eligible");

  // Step 5: Record successful access on-chain
  lastStatus = disclose("access-granted");
  accessCount.increment(1);
}
